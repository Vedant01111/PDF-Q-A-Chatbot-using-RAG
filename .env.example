# Copy this file to .env and fill in your key.
#
# Default LLM is Groq — genuinely free, no credit card required.
# Get a free key in ~30 seconds at: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your-key-here

# --- Alternative: use OpenAI instead (paid, requires billing set up) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

# Optional overrides
LLM_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
VECTORSTORE_DIR=data/vectorstore
UPLOAD_DIR=data/uploads

# --- Database ---
# For local (non-Docker) runs, sqlite is fine and needs no setup:
# DATABASE_URL=sqlite:///./data/app.db
# When running via docker-compose, this is set automatically to point at the
# postgres service, but you can still override the credentials it uses below.
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=pdfqa
